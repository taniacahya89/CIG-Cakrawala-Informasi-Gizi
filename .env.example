# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/cig_db

# Mail (local development - use MailHog or similar)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@cig.local
